{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "lint:architecture": "depcruise --config .dependency-cruiser.cjs src",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.quality.config.cjs",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.quality.config.cjs --watch",
    "mock:api": "node --env-file=.env.order-api mock/server.cjs",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.quality.config.cjs --coverage",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "test:ci": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.quality.config.cjs --ci --coverage --runInBand",
    "audit:dependencies": "npm audit --audit-level=high",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "knowledge:ingest": "ts-node -r tsconfig-paths/register src/modules/knowledge/ingest.cli.ts",
    "prepare": "cd .. && husky backend/.husky",
    "quality": "npm run format:check && npm run lint && npm run typecheck && npm run lint:architecture && npm run build && npm run test:ci"
  },
  "dependencies": {
    "@langchain/core": "1.5.1",
    "@langchain/langgraph": "1.7.5",
    "@langchain/openai": "1.8.5",
    "@langchain/textsplitters": "1.0.2",
    "@langfuse/otel": "5.14.0",
    "@langfuse/tracing": "5.14.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/throttler": "6.8.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/otlp-exporter-base": "0.221.0",
    "@opentelemetry/sdk-trace-node": "2.12.1",
    "drizzle-orm": "0.45.4",
    "express-rate-limit": "8.7.5",
    "helmet": "^8.3.0",
    "nestjs-pino": "5.3.2",
    "openai": "6.49.0",
    "pdf-parse": "2.4.5",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "8.23.1",
    "@types/supertest": "^6.0.2",
    "dependency-cruiser": "18.9.0",
    "dotenv": "18.0.10",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "husky": "9.1.7",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
