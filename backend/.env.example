# Application
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Observability
LOG_LEVEL=info

# HTTP Security
CORS_ORIGIN=http://localhost:3001

# Database
# DATABASE_URL=postgresql://nexus_app:<password>@127.0.0.1:5432/nexus

# Authentication
# DEMO_CUSTOMER_001_TOKEN_HASH=
# DEMO_CUSTOMER_002_TOKEN_HASH=

# Enterprise API
ORDER_API_BASE_URL=http://127.0.0.1:3002
# ORDER_API_TOKEN=

# Artificial Intelligence
LLM_PROVIDER=mock
LLM_MODEL=gpt-5.4-mini
EMBEDDING_PROVIDER=mock
# OPENAI_API_KEY=

# Langfuse
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# External tracing
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false